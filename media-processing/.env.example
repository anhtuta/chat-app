# Host-side Micronaut worker (make run). Copied to .env by Make.
# Use localhost hostnames — the worker runs on your machine, not inside Docker network.
MEDIA_PROCESSING_WORKER_ENABLED=true
MEDIA_PROCESSING_CALLBACK_ENABLED=true
MEDIA_PROCESSING_CALLBACK_TOKEN=change-me-in-production
CHAT_APP_BACKEND_URL=http://localhost:9010
MEDIA_PROCESSING_LOCAL_TRIGGER_ENABLED=false
RABBITMQ_URI=amqp://guest:guest@localhost:5672
MEDIA_PROCESSING_MINIO_ENDPOINT=http://localhost:9000
MEDIA_PROCESSING_MINIO_ACCESS_KEY=minioadmin
MEDIA_PROCESSING_MINIO_SECRET_KEY=minioadmin
MEDIA_PROCESSING_MINIO_REGION=us-east-1
MEDIA_PROCESSING_MINIO_PATH_STYLE_ACCESS=true
